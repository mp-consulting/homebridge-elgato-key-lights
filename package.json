{
  "displayName": "Elgato Key Lights",
  "name": "@mp-consulting/homebridge-elgato-key-lights",
  "version": "1.1.0",
  "description": "A Homebridge plugin for Elgato Key Light and Key Light Air",
  "author": "MP Consulting",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mp-consulting/homebridge-elgato-key-lights.git"
  },
  "bugs": {
    "url": "https://github.com/mp-consulting/homebridge-elgato-key-lights/issues"
  },
  "funding": {
    "type": "paypal",
    "url": "https://paypal.me/mickaelpalma"
  },
  "engines": {
    "node": "^22.10.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "copy:ui-assets": "mp-ui-kit-copy --vendor",
    "build": "npm run copy:ui-assets && rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "homebridge-plugin",
    "elgato",
    "keylight",
    "key lights",
    "key light air",
    "streaming",
    "keylight air"
  ],
  "dependencies": {
    "@homebridge/plugin-ui-utils": "^2.2.6",
    "@mp-consulting/homebridge-ai-core": "^2.0.0",
    "axios": "^1.20.0",
    "bonjour-service": "^1.4.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mp-consulting/homebridge-ui-kit": "^1.2.0",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "eslint": "^10.10.0",
    "homebridge": "^2.4.0",
    "homebridge-config-ui-x": "^5.29.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@nestjs/platform-fastify": "^12.1.2",
    "fastify": "^5.12.5"
  },
  "files": [
    "dist",
    "homebridge-ui",
    "config.schema.json"
  ]
}
